#. Plugin Name of the plugin/theme
#: admin/agp-admin.php:67
msgid "AutoConvert Greeklish Permalinks"
msgstr "AutoConvert Greeklish Permalinks"

#: admin/agp-admin.php:67
msgid "Convert Greek Permalinks"
msgstr "Μετατροπή ελληνικών συνδέσμων"

#: admin/agp-admin.php:90
msgid ""
"<b>No permalink was converted.</b> All your permalinks were already in latin "
"characters."
msgstr ""
"<b>Κανένας σύνδεσμος δεν μετατράπηκε.</b>Όλοι οι σύνδεσμοί σας ήταν ήδη με  "
"λατινικούς χαρακτήρες."

#: admin/agp-admin.php:96
msgid "Permalinks conversion has started in the background."
msgstr "Η μετατροπή των συνδέσμων ξεκίνησε στο παρασκήνιο."

#: admin/agp-admin.php:117
msgid "Do you want all new permalinks to be converted to greeklish?"
msgstr "Θέλετε όλα οι νέοι σύνδεσμοι  να μετατρέπονται σε greeklish;"

#: admin/agp-admin.php:121
msgid "How do you want diphthongs to be converted?"
msgstr "Πώς θέλετε να μετατραπούν οι δίφθογγοι;"

#: admin/agp-admin.php:174
msgid "Simple conversion"
msgstr "Απλή μετατροπή"

#: admin/agp-admin.php:174
msgid ""
"For example \"ει\" becomes \"ei\", \"οι\" becomes \"οi\", \"μπ\" becomes \"mp"
"\" etc"
msgstr ""
"Για παράδειγμα \"ει\" γίνεται \"ei\", \"οι\" γίνεται \"oi\", \"μπ\" γίνεται "
"\"mp\""

#: admin/agp-admin.php:182
msgid "Advanced conversion"
msgstr "Προηγμένη μετατροπή"

#: admin/agp-admin.php:182
msgid "For example \"ει\", \"οι\" becomes \"i\", \"μπ\" becomes \"b\" etc"
msgstr "Για παράδειγμα \"ει\", \"οι\" γίνεται  \"i\", \"μπ\" γίνεται  \"b\""

#: admin/agp-admin.php:214
#, php-format
msgid "Permalinks conversion is at %s"
msgstr "Η μετατροπή των συνδέσμων είναι στο %s"

#: admin/agp-admin.php:227
msgid "Permalinks conversion is done!"
msgstr "Η μετατροπή των συνδέσμων ολοκληρώθηκε!"

#: admin/agp-admin.php:227
msgid "Dismiss"
msgstr "Κλείσιμο"

#: admin/agp-admin.php:370 admin/partials/agp-admin-view.php:15
msgid "Settings"
msgstr "Ρυθμίσεις"

#: admin/agp-admin.php:373
msgid "Convert old permalinks"
msgstr "Μετατροπή παλιών συνδέσμων"

#: admin/partials/agp-admin-view.php:12
msgid "Convert Permalinks to Greeklish"
msgstr "Μετατροπή συνδέσμων σε greeklish"

#: admin/partials/agp-admin-view.php:17 admin/partials/agp-converter-view.php:7
msgid "Convert old posts/terms"
msgstr "Μετατροπή παλιών δημοσιεύσεων/όρων"

#: admin/partials/agp-converter-view.php:8
msgid ""
"Depending on your server and the amount of permalinks that needs to be "
"converted, the conversion might take a few minutes to complete."
msgstr ""
"Ανάλογα με το server σας και το πλήθος των συνδέσμων που πρέπει να "
"μετατραπούν, μπορεί να χρειαστούν μερικά λεπτά για να ολοκληρωθεί η "
"μετατροπή."

#: admin/partials/agp-converter-view.php:14
#: admin/partials/agp-converter-view.php:17
msgid "Post types to convert"
msgstr "Τύποι δημοσιεύσεων για μετατροπή"

#: admin/partials/agp-converter-view.php:19
msgid "Select one or more post types"
msgstr "Επιλέξτε ένα ή περισσότερα είδη δημοσιεύσεων"

#: admin/partials/agp-converter-view.php:40
#: admin/partials/agp-converter-view.php:43
msgid "Taxonomies to convert"
msgstr "Ταξινομήσεις για μετατροπή"

#: admin/partials/agp-converter-view.php:45
msgid "Select one or more taxonomies"
msgstr "Επιλέξτε ένα ή περισσότερα είδη ταξινομήσεων"

#: admin/partials/agp-converter-view.php:67
msgid "Convert Permalinks"
msgstr "Μετατροπή Συνδέσμων"

#: admin/partials/agp-log-view.php:15
msgid "post"
msgstr "δημοσιεύση"

#: admin/partials/agp-log-view.php:15
msgid "posts"
msgstr "δημοσιεύσεις"

#: admin/partials/agp-log-view.php:16
msgid "term"
msgstr "όρο"

#: admin/partials/agp-log-view.php:16
msgid "terms"
msgstr "όρους"

#: admin/partials/agp-log-view.php:21
msgid "Report of last conversion"
msgstr "Αναφορά τελευταίας μετατροπής"

#: admin/partials/agp-log-view.php:23
#, php-format
msgid "Started at %s and finished at %s. <br>Duration: %d second(s)"
msgstr ""
"Ξεκίνησε στις %s και ολοκληρώθηκε στις %s. <br>Διάρκεια: %d δεύτερόλεπτα"

#: admin/partials/agp-log-view.php:26
#, php-format
msgid "Permalinks successfully converted %d/%d %s and %d/%d %s."
msgstr "Μετατράπηκαν επιτυχημένα οι σύνδεσμοι για %d/%d %s και %d/%d %s."

#: admin/partials/agp-log-view.php:31
msgid "The following errors occurred"
msgstr "Παρουσιάστηκαν τα ακόλουθα σφάλματα"

#: admin/partials/agp-log-view.php:37
#, php-format
msgid "The post <a href=\"%s\">%s</a> was not converted. %s"
msgstr "Η δημοσίευση < a href =\" %s \">%s </a>  δεν μετατράπηκε. %s"

#: admin/partials/agp-log-view.php:42
#, php-format
msgid "The term <a href=\"%s\">%s</a> was not converted. %s"
msgstr "Ο όρος <a href =\" %s \">%s </a> δεν μετατράπηκε. %s"

#: admin/partials/agp-settings-view.php:8
msgid "Save Settings"
msgstr "Αποθήκευση Αλλαγών"

#: vendor/wp-background-processing/classes/wp-background-process.php:425
#, php-format
msgid "Every %d Minutes"
msgstr "Κάθε %d λεπτά"

#. Plugin URI of the plugin/theme
msgid "https://github.com/dimavroudis/AutoConvert-Greeklish-Permalink"
msgstr "https://github.com/dimavroudis/AutoConvert-Greeklish-Permalink"

#. Description of the plugin/theme
msgid ""
"Convert Greek characters to Latin on all your site's permalinks instantly."
msgstr ""
"Μετατρέψτε τους ελληνικούς χαρακτήρες σε λατινικούς σε όλες τους συνδέσμους "
"του ιστότοπού σας αμέσως."

#. Author of the plugin/theme
msgid "Dimitris Mavroudis"
msgstr "Δημήτρης Μαυρουδης"

